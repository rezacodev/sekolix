  created_by  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  creator Staff? @relation("ExtracurricularCreator", fields: [created_by], references: [id], onDelete: SetNull)
  coaches ExtracurricularCoach[]
  members ExtracurricularMember[]
  schedules ExtracurricularSchedule[]
  achievements ExtracurricularAchievement[]
  registrations ExtracurricularRegistration[]

  @@index([category, is_active])
  @@index([created_by])
  @@map("extracurriculars")
}

model ExtracurricularCoach {
  id                 String   @id @default(cuid())
  extracurricular_id String
  staff_id           String
  role               String   @default("PEMBINA")
  is_primary         Boolean  @default(false)
  createdAt          DateTime @default(now())

  extracurricular Extracurricular @relation(fields: [extracurricular_id], references: [id], onDelete: Cascade)
  staff Staff @relation(fields: [staff_id], references: [id], onDelete: Cascade)

  @@unique([extracurricular_id, staff_id])
  @@index([staff_id])
  @@map("extracurricular_coaches")
}

model ExtracurricularMember {
  id                 String   @id @default(cuid())
  extracurricular_id String
  student_id         String
  status             String   @default("ACTIVE")
  joined_at          DateTime @default(now()) @db.Date
  notes              String?  @db.Text
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  extracurricular Extracurricular @relation(fields: [extracurricular_id], references: [id], onDelete: Cascade)
  student PesertaDidik @relation(fields: [student_id], references: [id], onDelete: Cascade)
  attendances ExtracurricularAttendance[]

  @@unique([extracurricular_id, student_id])
  @@index([student_id, status])
  @@map("extracurricular_members")
}

model ExtracurricularSchedule {
  id                 String    @id @default(cuid())
  extracurricular_id String
  title              String
  type               String    @default("TRAINING")
  start_at           DateTime
  end_at             DateTime?
  location           String?
  description        String?   @db.Text
  status             String    @default("SCHEDULED")
  is_published       Boolean   @default(false)
  published_event_id String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  extracurricular Extracurricular @relation(fields: [extracurricular_id], references: [id], onDelete: Cascade)
  attendances ExtracurricularAttendance[]

  @@index([extracurricular_id, start_at])
  @@index([status, start_at])
  @@map("extracurricular_schedules")
}

model ExtracurricularAttendance {
  id          String   @id @default(cuid())
  schedule_id String
  member_id   String?
  student_id  String
  status      String   @default("PRESENT")
  recorded_by String?
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  schedule ExtracurricularSchedule @relation(fields: [schedule_id], references: [id], onDelete: Cascade)
  member ExtracurricularMember? @relation(fields: [member_id], references: [id], onDelete: SetNull)
  student PesertaDidik @relation(fields: [student_id], references: [id], onDelete: Cascade)
  recorder Staff? @relation("ExtracurricularAttendanceRecorder", fields: [recorded_by], references: [id], onDelete: SetNull)

  @@unique([schedule_id, student_id])
  @@index([student_id, status])
  @@index([recorded_by])
  @@map("extracurricular_attendances")
}

model ExtracurricularAchievement {
  id                 String    @id @default(cuid())
  extracurricular_id String
  student_id         String?
  title              String
  level              String?
  organizer          String?
  achieved_at        DateTime? @db.Date
  rank               String?
  description        String?   @db.Text
  certificate_url    String?
  portfolio_visible  Boolean   @default(true)
  verified_by        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  extracurricular Extracurricular @relation(fields: [extracurricular_id], references: [id], onDelete: Cascade)
  student PesertaDidik? @relation(fields: [student_id], references: [id], onDelete: SetNull)
  verifier Staff? @relation("ExtracurricularAchievementVerifier", fields: [verified_by], references: [id], onDelete: SetNull)

  @@index([extracurricular_id, achieved_at])
  @@index([student_id, portfolio_visible])
  @@index([verified_by])
  @@map("extracurricular_achievements")
}

model ExtracurricularRegistration {
  id                 String    @id @default(cuid())
  extracurricular_id String
  student_id         String
  motivation         String?   @db.Text
  status             String    @default("PENDING")
  reviewed_by        String?
  reviewed_at        DateTime?
  review_note        String?   @db.Text
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  extracurricular Extracurricular @relation(fields: [extracurricular_id], references: [id], onDelete: Cascade)
  student PesertaDidik @relation(fields: [student_id], references: [id], onDelete: Cascade)
  reviewer Staff? @relation("ExtracurricularRegistrationReviewer", fields: [reviewed_by], references: [id], onDelete: SetNull)

  @@unique([extracurricular_id, student_id])
  @@index([student_id, status])
  @@index([reviewed_by])
  @@map("extracurricular_registrations")
}

enum IntegrationDirection {
  IMPORT
  EXPORT
  BOTH
}

enum ImportBatchStatus {
  UPLOADED
  VALIDATED
  IMPORTED
  FAILED
  ROLLED_BACK
}

enum ValidationSeverity {
  INFO
  WARNING
  ERROR
}

model DataIntegrationProfile {
  id            String               @id @default(cuid())
  code          String               @unique
  name          String
  description   String?              @db.Text
  target_system String
  school_level  String               @default("GENERAL")
  direction     IntegrationDirection @default(BOTH)
  is_active     Boolean              @default(true)
  settings      Json?
  created_at    DateTime             @default(now())
  updated_at    DateTime             @updatedAt

  mappings        DataFieldMapping[]
  importBatches   ImportBatch[]
  exportBatches   ExportBatch[]
  validationRules DataValidationRule[]

  @@index([target_system, school_level])
  @@map("data_integration_profiles")
}

model DataFieldMapping {
  id             String   @id @default(cuid())
  profile_id     String
  entity         String
  internal_field String
  target_field   String
  label          String
  required       Boolean  @default(false)
  transform      String?
  sort_order     Int      @default(0)
  notes          String?  @db.Text
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  profile DataIntegrationProfile @relation(fields: [profile_id], references: [id], onDelete: Cascade)

  @@unique([profile_id, entity, internal_field, target_field])
  @@index([entity])
  @@map("data_field_mappings")
}

model ImportBatch {
  id             String            @id @default(cuid())
  profile_id     String
  entity         String
  file_name      String?
  source_url     String?
  status         ImportBatchStatus @default(UPLOADED)
  total_rows     Int               @default(0)
  valid_rows     Int               @default(0)
  error_rows     Int               @default(0)
  created_by     String?
  imported_at    DateTime?
  rolled_back_at DateTime?
  created_at     DateTime          @default(now())
  updated_at     DateTime          @updatedAt

  profile DataIntegrationProfile @relation(fields: [profile_id], references: [id], onDelete: Cascade)
  rows    ImportBatchRow[]

  @@index([profile_id, entity])
  @@index([status, created_at])
  @@map("import_batches")
}

model ImportBatchRow {
  id                String   @id @default(cuid())
  batch_id          String
  row_number        Int
  raw_data          Json
  mapped_data       Json?
  status            String   @default("VALID")
  errors            Json?
  created_record_id String?
  created_at        DateTime @default(now())

  batch ImportBatch @relation(fields: [batch_id], references: [id], onDelete: Cascade)

  @@unique([batch_id, row_number])
  @@index([status])
  @@index([created_record_id])
  @@map("import_batch_rows")
}

model ExportBatch {
  id         String   @id @default(cuid())
  profile_id String
  entity     String
  format     String   @default("XLSX")
  file_name  String?
  row_count  Int      @default(0)
  created_by String?
  metadata   Json?
  created_at DateTime @default(now())

  profile DataIntegrationProfile @relation(fields: [profile_id], references: [id], onDelete: Cascade)

  @@index([profile_id, entity])
  @@index([created_at])
  @@map("export_batches")
}

model DataValidationRule {
  id         String             @id @default(cuid())
  profile_id String?
  entity     String
  field      String
  rule       String
  severity   ValidationSeverity @default(WARNING)
  message    String
  is_active  Boolean            @default(true)
  created_at DateTime           @default(now())
  updated_at DateTime           @updatedAt

  profile DataIntegrationProfile? @relation(fields: [profile_id], references: [id], onDelete: Cascade)

  @@index([entity, field])
  @@index([profile_id])
  @@map("data_validation_rules")
}

model DataValidationIssue {
  id         String             @id @default(cuid())
  entity     String
  record_id  String?
  field      String
  severity   ValidationSeverity
  message    String
  source     String             @default("SYSTEM")
  status     String             @default("OPEN")
  metadata   Json?
  created_at DateTime           @default(now())
  updated_at DateTime           @updatedAt

  @@index([entity, status])
  @@index([severity, created_at])
  @@index([record_id])
  @@map("data_validation_issues")
}

// Dynamic operational roles for governance modules.
// UserRole remains the coarse portal role; AccessRole models school operations
// such as BENDAHARA, BK, PUSTAKAWAN, SARPRAS, and TU without enum migrations.
model AccessRole {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?  @db.Text
  is_system   Boolean  @default(false)
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  assignments UserAccessRole[]
  permissions AccessPermission[]

  @@map("access_roles")
}

model UserAccessRole {
  id          String    @id @default(cuid())
  user_id     String
  role_id     String
  assigned_by String?
  assigned_at DateTime  @default(now())
  expires_at  DateTime?
  is_active   Boolean   @default(true)
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  user        User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  role        AccessRole @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@unique([user_id, role_id])
  @@index([user_id, is_active])
  @@index([role_id, is_active])
  @@map("user_access_roles")
}

model AccessPermission {
  id          String   @id @default(cuid())
  role_id     String
  subject     String
  action      String
  inverted    Boolean  @default(false)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  role        AccessRole @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@unique([role_id, subject, action])
  @@index([subject, action])
  @@map("access_permissions")
}

model ActivityLog {
  id             String   @id @default(cuid())
  actor_user_id  String?
  actor_name     String?
  module         String
  action         String
  entity_type    String?
  entity_id      String?
  metadata       Json?
  ip_address     String?
  user_agent     String?  @db.Text
  created_at     DateTime @default(now())

  @@index([module, action])
  @@index([actor_user_id, created_at])
  @@index([entity_type, entity_id])
  @@index([created_at])
  @@map("activity_logs")
}

model AuditTrail {
  id             String   @id @default(cuid())
  actor_user_id  String?
  entity_type    String
  entity_id      String
  action         String
  before         Json?
  after          Json?
  reason         String?  @db.Text
  metadata       Json?
  created_at     DateTime @default(now())

  @@index([entity_type, entity_id])
  @@index([actor_user_id, created_at])
  @@index([action, created_at])
  @@map("audit_trails")
}

model ApprovalRequest {
  id                String   @id @default(cuid())
  module            String
  action            String
  entity_type       String?
  entity_id         String?
  title             String
  description       String?  @db.Text
  requested_by      String?
  requested_by_name String?
  status            String   @default("PENDING")
  payload           Json?
  current_step      Int      @default(1)
  decided_by        String?
  decided_at        DateTime?
  decision_note     String?  @db.Text
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  steps             ApprovalStep[]

  @@index([module, status])
  @@index([requested_by, created_at])
  @@index([entity_type, entity_id])
  @@map("approval_requests")
}

model ApprovalStep {
  id                  String   @id @default(cuid())
  approval_request_id String
  step_order          Int
  approver_role_slug  String?
  approver_user_id    String?
  status              String   @default("PENDING")
  decided_by          String?
  decided_at          DateTime?
  note                String?  @db.Text
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  request             ApprovalRequest @relation(fields: [approval_request_id], references: [id], onDelete: Cascade)

  @@unique([approval_request_id, step_order])
  @@index([status, step_order])
  @@map("approval_steps")
}
