// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Authentication & User Management
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  password      String?
  image         String?
  role          UserRole  @default(USER)
  isActive      Boolean   @default(true)
  adminTheme    String    @default("classic-light")
  teacherTheme  String    @default("minimalist-light")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  staff   Staff[]

  @@map("users")
}

enum UserRole {
  SUPERADMIN
  ADMIN
  GURU
  STAFF
  MURID
  ORANGTUA
  // Legacy — kept for migration safety
  EDITOR
  USER
}

model Account {
  id                 String    @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?   @db.Text
  access_token       String?   @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?   @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// Content Management
model Page {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  content     String   @db.Text
  description String?
  data        Json?                          // Structured data for different page types
  isPublished Boolean  @default(false)
  isVisible   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("landing_pages")
}

model Article {
  id              String   @id @default(cuid())
  title           String
  slug            String   @unique
  content         String   @db.Text
  excerpt         String?
  image           String?
  featuredImage   String?  // Featured image for detail page
  category        String?
  tags            String[] @default([])  // Array of tags
  author          String?  // Author name
  readTime        Int?     // Reading time in minutes
  metaDescription String?  // SEO meta description
  isPublished     Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  publishedAt     DateTime?

  @@map("landing_articles")
}

model News {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  content     String   @db.Text
  excerpt     String?
  image       String?
  category    String?
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  publishedAt DateTime?

  @@map("landing_news")
}

model Event {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String   @db.Text
  startDate   DateTime
  endDate     DateTime?
  location    String?
  image       String?
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("landing_events")
}

model Album {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  galleries   Gallery[] @relation("GalleryToAlbum")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("landing_albums")
}

model Gallery {
  id        String   @id @default(cuid())
  title     String
  image     String
  albumId   String?  // Foreign key to Album
  album     Album?   @relation("GalleryToAlbum", fields: [albumId], references: [id], onDelete: SetNull)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([albumId])
  @@map("landing_galleries")
}

model LandingSection {
  id        String   @id @default(cuid())
  slug      String   @unique // Changed: removed themeId, slug now globally unique
  type      String   // Type: hero, stats, programs, philosophy, cta, about, etc.
  title     String
  subtitle  String?
  body      String?  @db.Text
  image     String?
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  metadata  String?  @db.Text // JSON for theme-specific customizations if needed
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("landing_sections")
}

enum ApplicantStatus {
  pending
  review
  accepted
  rejected
}

model Applicant {
  id             String          @id @default(cuid())
  registrationCode String?        @unique // Auto-generated registration code
  nik            String          @unique
  phone          String
  fullName       String
  email          String?
  schoolOrigin   String?
  programChoice  String?
  programId      String?
  academicYearId String?
  status         ApplicantStatus @default(pending)
  submissionData Json?
  notes          String?
  handledBy      String?
  profileCompleted Boolean       @default(false)
  
  // Personal Data
  gender         String?
  nisn           String?
  noKK           String?
  placeOfBirth   String?
  dateOfBirth    DateTime?
  nationality    String?
  religion       String?
  motherTongue   String?
  address        String?
  village        String?
  district       String?
  city           String?
  province       String?
  postalCode     String?
  
  // Father Data
  fatherName     String?
  fatherNik      String?
  fatherBirthYear Int?
  fatherEducation String?
  fatherOccupation String?
  fatherIncome   String?
  
  // Mother Data
  motherName     String?
  motherNik      String?
  motherBirthYear Int?
  motherEducation String?
  motherOccupation String?
  motherIncome   String?
  
  // Guardian Data
  guardianName   String?
  guardianNik    String?
  guardianBirthYear Int?
  guardianEducation String?
  guardianOccupation String?
  guardianIncome String?
  
  // Contact Data
  mobile         String?
  
  // Student Details
  livesWith      String?
  weight         Float?
  height         Float?
  distanceToSchool Float?
  transportationMode String?
  anakKe         Int?
  jumlahSaudara  Int?
  
  // Achievements
  achievements   String?
  
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  payments       ApplicantPayment[]
  validations    ApplicantValidation[]
  program        Program?         @relation(fields: [programId], references: [id])
  academicYear   TahunAjaran?     @relation(fields: [academicYearId], references: [id])

  @@index([programId])
  @@index([academicYearId])
}

// Peserta didik (siswa aktif) - separate table but similar to Applicant
model PesertaDidik {
  id               String    @id @default(cuid())
  registrationCode String?   @unique
  nik              String    @unique
  phone            String
  fullName         String
  email            String?
  schoolOrigin     String?
  programChoice    String?
  programId        String?
  entryYearId      String?
  status           ApplicantStatus @default(pending)
  submissionData   Json?
  notes            String?
  handledBy        String?
  profileCompleted Boolean   @default(false)

  // Personal Data
  gender         String?
  nisn           String?
  noKK           String?
  placeOfBirth   String?
  dateOfBirth    DateTime?
  nationality    String?
  religion       String?
  motherTongue   String?
  address        String?
  village        String?
  district       String?
  city           String?
  province       String?
  postalCode     String?

  // Father Data
  fatherName     String?
  fatherNik      String?
  fatherBirthYear Int?
  fatherEducation String?
  fatherOccupation String?
  fatherIncome   String?

  // Mother Data
  motherName     String?
  motherNik      String?
  motherBirthYear Int?
  motherEducation String?
  motherOccupation String?
  motherIncome   String?

  // Guardian Data
  guardianName   String?
  guardianNik    String?
  guardianBirthYear Int?
  guardianEducation String?
  guardianOccupation String?
  guardianIncome String?

  // Contact Data
  mobile         String?

  // Student Details
  livesWith      String?
  weight         Float?
  height         Float?
  distanceToSchool Float?
  transportationMode String?
  anakKe         Int?
  jumlahSaudara  Int?

  // Achievements
  achievements   String?

  deleted_at     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  program        Program?        @relation(fields: [programId], references: [id])
  entryYear      TahunAjaran?    @relation(fields: [entryYearId], references: [id])
  rombels        Rombel[]
  grades         Grade[]
  reportCards    ReportCard[]
  examResults    ExamResult[]
  examAttempts   ExamAttempt[]
  transfers      Transfer[]
  attendances    Attendance[]
  assignmentSubmissions AssignmentSubmission[]
  @@index([programId])
  @@index([entryYearId])
  @@map("peserta_didik")
}

model ApplicantPayment {
  id           String     @id @default(cuid())
  applicantId  String
  method       String
  amount       Int
  proofUrl     String?
  status       String     @default("pending")
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  applicant    Applicant  @relation(fields: [applicantId], references: [id], onDelete: Cascade)
}

model ApplicantValidation {
  id           String     @id @default(cuid())
  applicantId  String
  validatorId  String?
  result       String     // valid/invalid/needs-info
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  applicant    Applicant  @relation(fields: [applicantId], references: [id], onDelete: Cascade)
}

model AdmissionLandingSetting {
  id                  String   @id @default(cuid())
  heroTitle           String
  heroDescription     String?
  isApplyFormEnabled  Boolean  @default(true)  // Enable/disable apply form di landing
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("admission_landing_settings")
}

model AdmissionRegistrationCodeSetting {
  id              String   @id @default(cuid())
  tahunAjaranId   String   @unique           // Foreign key ke tahun ajaran (satu setting per tahun)
  prefix          String   @default("DAFTAR")  // Prefix (e.g., "DAFTAR")
  suffix          String   @default("")        // Suffix (e.g., "-2024")
  padLength       Int      @default(4)         // Number padding (1, 001, 0001, etc.)
  includeYearCode Boolean  @default(true)      // Include academic year code
  nextNumber      Int      @default(1)         // Next sequence number to use
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tahunAjaran     TahunAjaran @relation(fields: [tahunAjaranId], references: [id], onDelete: Cascade)

  @@map("admission_registration_code_settings")
  @@index([tahunAjaranId])
}

model Program {
  id           String         @id @default(cuid())
  name         String
  code         String?
  description  String?
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  applicants   Applicant[]
  pesertaDidik PesertaDidik[]
  rombels      Rombel[]
  subjects     SubjectProgram[]

  @@map("programs")
}

model TahunAjaran {
  id         String     @id @default(cuid())
  label      String
  yearCode   String?    // Year code for registration code generation (e.g., "24", "2425")
  startDate  DateTime?
  endDate    DateTime?
  isActive   Boolean    @default(false)
  registrationFee Int    @default(0)
  deleted_at DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  applicants                        Applicant[]
  pesertaDidik                      PesertaDidik[]
  rombels                           Rombel[]
  registrationCodeSetting           AdmissionRegistrationCodeSetting?
  academicEvents                    AcademicEvent[]
  reportCards                       ReportCard[]
  semesters                         AcademicSemester[]
  transferBatchesFrom               TransferBatch[] @relation("TransferFromYear")
  transferBatchesTo                 TransferBatch[] @relation("TransferToYear")

  @@map("tahun_ajaran")
  @@index([isActive])
}

// Academic events / kegiatan per tahun ajaran
model AcademicEvent {
  id             String      @id @default(cuid())
  tahunAjaranId  String
  title          String
  description    String?     @db.Text
  startDate      DateTime
  endDate        DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  tahunAjaran    TahunAjaran @relation(fields: [tahunAjaranId], references: [id], onDelete: Cascade)

  @@map("academic_events")
  @@index([tahunAjaranId])
}

// Faculty Management
// NOTE: `Faculty` model removed — use `Staff` model instead (unified table)

// Unified staff table used for both landing faculty and akademik data-guru
enum StaffRole {
  TEACHER
  STAFF
  OTHER
}

model Staff {
  id        String    @id @default(cuid())
  userId    String?
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  name      String
  role      StaffRole @default(TEACHER)
  // Employment & Identity
  nip         String?   @unique
  niy         String?
  nuptk       String?
  nik         String?
  statusKepegawaian String?   // PNS, Non-PNS
  nrg         String?   // Nomor Registrasi Guru
  masaKerja   Int?      // total years/months as integer (unit agreed by app)
  mkg         Int?      // Masa Kerja Guru (MKG)

  // Personal Data
  position    String?
  department  String?
  placeOfBirth String?
  dateOfBirth DateTime?
  gender      String?
  religion    String?
  maritalStatus String?
  address     String?
  city        String?
  province    String?
  postalCode  String?

  // Contact
  photo       String?
  image       String?   @map("image")
  email       String?   @unique
  phone       String?

  // Education & Competency
  educationHistory Json? // structured array: [{level: "S1", major: "...", year: 20xx}, ...]
  academicDegree   String?
  educatorCertification Json? // details about certification(s)
  trainingHistory  Json?

  // Assignment / PTK details
  subjects         Json? // array or JSON listing subjects taught
  workloadHours    Int?  // teaching hours per week
  extraDuties      Json? // additional roles/tasks
  gtkPosition      String? // role: Kepala Sekolah, Guru Kelas, etc.
  jenisPTK         String? // Kepala Sekolah, Guru, Tenaga Kependidikan
  jabatanPTK       String? // Guru IPA, Guru Bahasa, dll

  // Allowances & Family
  professionalAllowanceStatus String? // e.g., valid/invalid
  familyInfo       Json?

  bio            String?   @db.Text
  order          Int      @default(0)
  isVisible      Boolean   @default(true)
  isActive       Boolean   @default(true)
  deleted_at     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  teacherSubjects TeacherSubject[]
  recordedAttendances Attendance[] // Absensi yang dicatat oleh staff ini
  recordedJournals TeachingJournal[] @relation("JournalRecorder") // Jurnal yang dicatat
  uploadedMaterials TeachingMaterial[] @relation("MaterialUploader") // Materi yang diupload
  createdSyllabuses Syllabus[] @relation("SyllabusCreator") // Silabus yang dibuat
  approvedSyllabuses Syllabus[] @relation("SyllabusApprover") // Silabus yang diapprove
  createdLessonPlans LessonPlan[] @relation("LessonPlanCreator") // RPP yang dibuat
  approvedLessonPlans LessonPlan[] @relation("LessonPlanApprover") // RPP yang diapprove
  gradedSubmissions AssignmentSubmission[] @relation("AssignmentGrader") // Submission yang dinilai
  questionBanks QuestionBank[] // Soal yang dibuat oleh guru ini
  examPackages  ExamPackage[]
  examSchedules ExamSchedule[]
  discussions   Discussion[]

  @@map("gtk")
  @@index([userId])
}

// NOTE: `Teacher` model removed — data should be migrated into `Staff` with role TEACHER

// Theme Configuration
model ThemeConfig {
  id              String   @id @default(cuid())
  name            String   // Theme name (Academic Classic, Modern Vibrant, etc.)
  themeId         String   @unique // academic-classic, modern-vibrant, minimalist-clean
  isActive        Boolean  @default(false) // Only one theme can be active
  
  // Main Colors
  primaryColor    String   @default("#001f3f")
  secondaryColor  String   @default("#FFFFFF")
  accentColor     String   @default("#FFD700")
  
  // Additional Colors
  textColor       String   @default("#1f2937") // Body text color
  borderColor     String   @default("#e5e7eb") // Border and divider color
  grayColor       String   @default("#6b7280") // Subtle elements color
  
  // Typography
  headingFont     String   @default("'Playfair Display', serif")
  bodyFont        String   @default("Inter, sans-serif")
  
  // Logo
  logoUrl         String?
  customLogoUrl   String?
  
  // Default Colors Storage (for reset functionality)
  defaultPrimaryColor    String   @default("#001f3f")
  defaultSecondaryColor  String   @default("#FFFFFF")
  defaultAccentColor     String   @default("#FFD700")
  defaultTextColor       String   @default("#1f2937")
  defaultBorderColor     String   @default("#e5e7eb")
  defaultGrayColor       String   @default("#6b7280")
  defaultHeadingFont     String   @default("'Playfair Display', serif")
  defaultBodyFont        String   @default("Inter, sans-serif")
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("landing_theme_configs")
}

// Media Management
model Media {
  id          String   @id @default(cuid())
  title       String?
  description String?
  url         String   // Cloudinary URL
  publicId    String   @unique // Cloudinary public ID for deletion
  type        String   // image, video, raw
  folder      String?  // Cloudinary folder path
  size        Int?     // File size in bytes
  width       Int?     // Image/video width
  height      Int?     // Image/video height
  format      String?  // jpg, png, mp4, etc.
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("landing_media")
}

// School identity / site identity used by admin settings
model SchoolIdentity {
  id             String   @id @default(cuid())
  name           String
  shortName      String?
  schoolLevel    SchoolLevel @default(SD)
  npsn           String?
  address        String?
  postalCode     String?
  phone          String?
  email          String?
  website        String?
  logoUrl        String?
  logoDarkUrl    String?
  faviconUrl     String?
  coverImageUrl  String?
  headmaster     String?
  headmasterNIP  String?
  accreditation  String?
  establishedYear Int?
  timezone       String?  @default("Asia/Jakarta")
  language       String?  @default("id")
  metaDescription String?
  socialLinks    Json?
  defaultTheme   String?
  settings       Json?
  isPublic       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("landing_school_identity")
}

// Academic Models
enum Level {
  SD
  SMP
  SMA
  SMK
}

enum SchoolLevel {
  SD
  MI
  SMP
  MTS
  SMA
  MA
  SMK
}

model Curriculum {
  id          BigInt     @id @default(autoincrement())
  code        String?    @unique
  name        String
  description String?
  subjects    SubjectCurriculum[]
  deleted_at  DateTime?
  created_at  DateTime   @default(now())
  updated_at  DateTime   @updatedAt

  @@map("curriculums")
}

model Subject {
  id            BigInt      @id @default(autoincrement())
  code          String?     @unique
  name          String
  is_practice   Boolean     @default(false)
  kkm           Int?        // Kriteria Ketuntasan Minimal
  deleted_at    DateTime?
  created_at    DateTime    @default(now())
  updated_at    DateTime    @updatedAt

  curriculums   SubjectCurriculum[]
  classes       SubjectClass[]
  programs      SubjectProgram[]
  teacherSubjects TeacherSubject[]
  assessments     Assessment[]
  onlineClasses   OnlineClass[]
  questionBanks   QuestionBank[]
  examPackages    ExamPackage[]
  exams           Exam[]
  teachingMaterials TeachingMaterial[]
  discussions     Discussion[]
  syllabuses    Syllabus[]
  lessonPlans   LessonPlan[]
  assignments   Assignment[]
  rubrics       AssessmentRubric[]

  @@map("subjects")
}

// Junction table for Subject-Curriculum many-to-many relationship
model SubjectCurriculum {
  id            BigInt     @id @default(autoincrement())
  subject_id    BigInt
  curriculum_id BigInt
  deleted_at    DateTime?
  created_at    DateTime   @default(now())
  updated_at    DateTime   @updatedAt

  subject       Subject    @relation(fields: [subject_id], references: [id], onDelete: Cascade)
  curriculum    Curriculum @relation(fields: [curriculum_id], references: [id], onDelete: Cascade)

  @@unique([subject_id, curriculum_id])
  @@map("subject_curriculums")
}

// Junction table for Subject-Class many-to-many relationship
model SubjectClass {
  id         BigInt   @id @default(autoincrement())
  subject_id BigInt
  class_id   BigInt
  deleted_at DateTime?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  subject    Subject  @relation(fields: [subject_id], references: [id], onDelete: Cascade)
  class      Class    @relation(fields: [class_id], references: [id], onDelete: Cascade)

  @@unique([subject_id, class_id])
  @@map("subject_classes")
}

// Junction table for Subject-Program many-to-many relationship
model SubjectProgram {
  id         BigInt   @id @default(autoincrement())
  subject_id BigInt
  program_id String
  deleted_at DateTime?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  subject    Subject  @relation(fields: [subject_id], references: [id], onDelete: Cascade)
  program    Program  @relation(fields: [program_id], references: [id], onDelete: Cascade)

  @@unique([subject_id, program_id])
  @@map("subject_programs")
}

// Kelas (tingkat/jenjang: 1-6 untuk SD, 1-3 untuk SMP, dst)
model Class {
  id         BigInt      @id @default(autoincrement())
  name       String      // Nomor kelas: "1", "2", "3", dst
  deleted_at DateTime?
  created_at DateTime    @default(now())
  updated_at DateTime    @updatedAt

  rombels        Rombel[]
  subjects       SubjectClass[]
  teacherSubjects TeacherSubject[]
  classSchedules ClassSchedule[]
  onlineClasses  OnlineClass[]
  transfersFrom  Transfer[] @relation("TransferFromClass")
  transfersTo    Transfer[] @relation("TransferToClass")
  teachingMaterials TeachingMaterial[]
  syllabuses     Syllabus[]
  lessonPlans    LessonPlan[]

  @@map("classes")
}

// Rombel (rombongan belajar)
model Rombel {
  id         BigInt      @id @default(autoincrement())
  class_id   BigInt
  program_id String
  tahunAjaranId String?
  name       String      // Nama rombel (contoh: X IPA 1, XI IPS 2)
  capacity   Int?        // Kapasitas maksimal
  student_count Int      @default(0)
  deleted_at DateTime?
  created_at DateTime    @default(now())
  updated_at DateTime    @updatedAt

  class      Class       @relation(fields: [class_id], references: [id])
  program    Program     @relation(fields: [program_id], references: [id])
  tahunAjaran TahunAjaran? @relation(fields: [tahunAjaranId], references: [id])
  students   PesertaDidik[]
  transfersFrom Transfer[] @relation("TransferFromGroup")
  transfersTo   Transfer[] @relation("TransferToGroup")
  teacherSubjects TeacherSubject[]
  schedules       ClassSchedule[]
  attendances     Attendance[]
  teachingJournals TeachingJournal[]
  assignments Assignment[]
  rubrics      AssessmentRubric[]
  examSchedules ExamSchedule[]
  discussions  Discussion[]

  @@map("class_groups")
}

// Relasi guru ↔ mata pelajaran ↔ kelas
model TeacherSubject {
  id         BigInt   @id @default(autoincrement())
  teacher_id String?
  subject_id BigInt
  class_id   BigInt
  rombel_id  BigInt?
  deleted_at DateTime?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  teacher    Staff?   @relation(fields: [teacher_id], references: [id])
  subject    Subject  @relation(fields: [subject_id], references: [id])
  class      Class    @relation(fields: [class_id], references: [id])
  rombel     Rombel?  @relation(fields: [rombel_id], references: [id])
  schedules  ClassSchedule[]
  attendances Attendance[] // Absensi untuk mata pelajaran ini
  teachingJournals TeachingJournal[] // Jurnal mengajar

  @@unique([teacher_id, subject_id, class_id])
  @@unique([teacher_id, subject_id, rombel_id])
  @@map("teacher_subjects")
}

// Room / Ruang / Kelas / Lab Management
enum RoomType {
  CLASSROOM // Ruang Kelas
  LABORATORY // Laboratorium
  LIBRARY // Perpustakaan
  SPORTS_HALL // Aula Olahraga
  AUDITORIUM // Auditorium
  OFFICE // Ruang Kantor
  OTHER // Lainnya
}

model Room {
  id          BigInt    @id @default(autoincrement())
  code        String?   @unique // Kode ruangan, e.g., R-101, LAB-IPA-1
  name        String    // Nama ruangan
  type        RoomType  @default(CLASSROOM)
  floor       String?   // Lantai
  building    String?   // Gedung
  capacity    Int?      // Kapasitas
  facilities  String?   @db.Text // Fasilitas yang tersedia (JSON atau text)
  description String?   @db.Text
  is_active   Boolean   @default(true)
  deleted_at  DateTime?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  @@map("rooms")
}

// Lesson Time / Jam Pelajaran Management
model LessonTime {
  id          BigInt    @id @default(autoincrement())
  day         DayOfWeek // Hari
  session     Int       // Jam ke-berapa (1, 2, 3, dst)
  start_time  String    // Format HH:mm (e.g., "07:30")
  end_time    String    // Format HH:mm (e.g., "08:15")
  is_break    Boolean   @default(false) // Apakah ini waktu istirahat
  break_label String?   // Label istirahat (e.g., "Istirahat 1", "Istirahat Sholat")
  is_active   Boolean   @default(true)
  deleted_at  DateTime?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  @@map("lesson_times")
}

// Jadwal pelajaran mingguan
enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model ClassSchedule {
  id                  BigInt        @id @default(autoincrement())
  class_id            BigInt
  rombel_id           BigInt?
  teacher_subject_id  BigInt
  day                 DayOfWeek
  period              Int?          // Jam ke-1 sampai ke-12
  start_time          DateTime?     // Time only, date ignored (optional, bisa pakai period atau start/end time)
  end_time            DateTime?     // Time only, date ignored (optional)
  room                String?
  deleted_at          DateTime?
  created_at          DateTime      @default(now())
  updated_at          DateTime      @updatedAt

  class               Class         @relation(fields: [class_id], references: [id])
  rombel              Rombel?       @relation(fields: [rombel_id], references: [id])
  teacherSubject      TeacherSubject @relation(fields: [teacher_subject_id], references: [id])

  @@map("class_schedules")
}

// Penilaian & nilai
enum AssessmentType {
  TUGAS
  UTS
  UAS
  PRAKTIK
  ULANGAN_HARIAN
}

model Assessment {
  id         BigInt         @id @default(autoincrement())
  subject_id BigInt
  title      String
  type       AssessmentType
  weight     Int            @default(1) // Bobot penilaian
  max_score  Decimal?       @default(100)
  deleted_at DateTime?
  created_at DateTime       @default(now())
  updated_at DateTime       @updatedAt

  subject    Subject        @relation(fields: [subject_id], references: [id])
  grades     Grade[]

  @@map("assessments")
}

// Rubrik Penilaian - untuk penilaian yang lebih variatif
model AssessmentRubric {
  id          BigInt   @id @default(autoincrement())
  subject_id  BigInt
  rombel_id   BigInt
  name        String   // Nama rubrik, misal: "Tugas Proyek", "Presentasi", dll
  description String?  @db.Text
  type        AssessmentType @default(TUGAS)
  weight      Int      @default(1)
  max_score   Decimal  @default(100)
  is_active   Boolean  @default(true)
  deleted_at  DateTime?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  subject     Subject  @relation(fields: [subject_id], references: [id])
  rombel      Rombel   @relation(fields: [rombel_id], references: [id])
  criteria    RubricCriteria[]
  grades      Grade[]

  @@map("assessment_rubrics")
}

// Semester akademik per tahun ajaran
model AcademicSemester {
  id             Int       @id @default(autoincrement())
  tahunAjaranId  String
  number         Int       // 1 atau 2
  label          String    // "Semester 1", "Ganjil", dll
  startDate      DateTime
  endDate        DateTime
  is_active      Boolean   @default(false)
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  tahunAjaran    TahunAjaran @relation(fields: [tahunAjaranId], references: [id])

  @@unique([tahunAjaranId, number])
  @@map("semesters")
}

// Konfigurasi email SMTP untuk notifikasi
model EmailNotificationConfig {
  id          Int      @id @default(1) // singleton row
  is_enabled  Boolean  @default(false)
  smtp_host   String?
  smtp_port   Int?     @default(587)
  smtp_user   String?
  smtp_pass   String?  // stored encrypted or plaintext (app-level decision)
  from_email  String?
  from_name   String?
  updated_at  DateTime @updatedAt

  @@map("email_notification_config")
}

// Toggle notifikasi dalam aplikasi (in-app)
model InAppNotificationSetting {
  id                    Int      @id @default(1) // singleton row
  new_applicant         Boolean  @default(true)
  payment_received      Boolean  @default(true)
  grade_submitted       Boolean  @default(false)
  new_assignment        Boolean  @default(false)
  attendance_summary    Boolean  @default(false)
  updated_at            DateTime @updatedAt

  @@map("in_app_notification_settings")
}

// Bobot komponen nilai global per tipe assessment
model GradeComponentWeight {
  id        Int            @id @default(autoincrement())
  component AssessmentType @unique
  weight    Int            @default(0) // Persentase 0-100; total semua komponen harus = 100
  updated_at DateTime      @updatedAt

  @@map("grade_component_weights")
}

// Skala konversi nilai angka → huruf (konfigurabel)
model GradeScale {
  id         Int      @id @default(autoincrement())
  grade      String   // "A", "B", "C", "D", "E"
  min_score  Int      // Batas bawah (inklusif)
  max_score  Int      // Batas atas (inklusif)
  label      String?  // "Sangat Baik", "Baik", dll (opsional)
  updated_at DateTime @updatedAt

  @@unique([grade])
  @@map("grade_scales")
}

// Kriteria penilaian dalam rubrik
model RubricCriteria {
  id          BigInt   @id @default(autoincrement())
  rubric_id   BigInt
  name        String   // Nama kriteria, misal: "Kelengkapan", "Kreativitas"
  description String?  @db.Text
  max_score   Decimal  @default(25)
  order       Int      @default(0)
  deleted_at  DateTime?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  rubric        AssessmentRubric @relation(fields: [rubric_id], references: [id], onDelete: Cascade)
  rubricScores  RubricScore[]

  @@map("rubric_criteria")
}

model Grade {
  id            BigInt   @id @default(autoincrement())
  student_id    String
  assessment_id BigInt
  score         Decimal
  rubric_id     BigInt?
  notes         String?
  deleted_at    DateTime?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  student      PesertaDidik     @relation(fields: [student_id], references: [id])
  assessment   Assessment       @relation(fields: [assessment_id], references: [id])
  rubric       AssessmentRubric? @relation(fields: [rubric_id], references: [id])
  rubricScores RubricScore[]

  @@unique([student_id, assessment_id])
  @@unique([student_id, rubric_id])
  @@map("grades")
}

model RubricScore {
  id                   BigInt   @id @default(autoincrement())
  grade_id             BigInt
  rubric_criterion_id  BigInt
  score                Decimal
  deleted_at           DateTime?
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt

  grade             Grade             @relation(fields: [grade_id], references: [id])
  rubricCriterion   RubricCriteria   @relation(fields: [rubric_criterion_id], references: [id])

  @@unique([grade_id, rubric_criterion_id])
  @@map("rubric_scores")
}

// Rapor
enum Semester {
  GANJIL
  GENAP
}

model ReportCard {
  id               BigInt   @id @default(autoincrement())
  student_id       String
  academic_year_id String
  semester         Semester
  average_score    Decimal?
  notes            String?
  deleted_at       DateTime?
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  student       PesertaDidik @relation(fields: [student_id], references: [id])
  academic_year TahunAjaran  @relation(fields: [academic_year_id], references: [id])

  @@unique([student_id, academic_year_id, semester])
  @@map("report_cards")
}

// E-Learning
model OnlineClass {
  id            BigInt   @id @default(autoincrement())
  class_id      BigInt
  subject_id    BigInt
  title         String
  description   String?
  deleted_at    DateTime?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  class         Class           @relation(fields: [class_id], references: [id])
  subject       Subject         @relation(fields: [subject_id], references: [id])
  materials     LearningMaterial[]
  assignments   Assignment[]

  @@map("online_classes")
}

enum MaterialType {
  VIDEO
  PDF
  IMAGE
  LINK
  DOCUMENT
}

model LearningMaterial {
  id               BigInt       @id @default(autoincrement())
  online_class_id  BigInt
  title            String
  content          String?      @db.Text // URL or embedded content
  type             MaterialType
  order            Int          @default(0)
  is_mandatory     Boolean      @default(true)
  deleted_at       DateTime?
  created_at       DateTime     @default(now())
  updated_at       DateTime     @updatedAt

  online_class     OnlineClass  @relation(fields: [online_class_id], references: [id])

  @@map("learning_materials")
}

model Assignment {
  id               BigInt   @id @default(autoincrement())
  online_class_id  BigInt?
  rombel_id        BigInt?
  subject_id       BigInt?
  academic_year    String?
  semester         Int?
  title            String
  description      String?  @db.Text
  due_date         DateTime
  max_score        Decimal? @default(100)
  deleted_at       DateTime?
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  online_class     OnlineClass?         @relation(fields: [online_class_id], references: [id])
  rombel           Rombel?              @relation(fields: [rombel_id], references: [id])
  subject          Subject?             @relation(fields: [subject_id], references: [id])
  submissions      AssignmentSubmission[]

  @@map("assignments")
}

model AssignmentSubmission {
  id               BigInt    @id @default(autoincrement())
  assignment_id    BigInt
  student_id       String
  submitted_at     DateTime?
  score            Decimal?
  feedback         String?   @db.Text
  attachment_url   String?
  attachment_name  String?
  status           String    @default("not_submitted") // not_submitted, submitted, graded
  graded_at        DateTime?
  graded_by        String?   // staff_id yang menilai
  deleted_at       DateTime?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt
  
  assignment       Assignment    @relation(fields: [assignment_id], references: [id])
  student          PesertaDidik  @relation(fields: [student_id], references: [id])
  grader           Staff?        @relation("AssignmentGrader", fields: [graded_by], references: [id])
  
  @@unique([assignment_id, student_id])
  @@map("assignment_submissions")
}

// CBT / CAT
enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  SHORT_ANSWER
  ESSAY
  MATCHING
}

enum Difficulty {
  MUDAH
  SEDANG
  SULIT
}

enum CognitiveLevel {
  MENGINGAT
  MEMAHAMI
  MENERAPKAN
  MENGANALISIS
  MENGEVALUASI
  MENCIPTAKAN
}

model QuestionBank {
  id             BigInt         @id @default(autoincrement())
  teacher_id     String         // Staff ID yang membuat soal
  subject_id     BigInt
  question_type  QuestionType
  difficulty     Difficulty     @default(SEDANG)
  cognitive_level CognitiveLevel @default(MEMAHAMI)
  question_text  String         @db.Text
  options        Json?          // For multiple choice options (array of strings)
  correct_answer String         @db.Text // Correct answer
  explanation    String?        @db.Text // Penjelasan jawaban
  tags           String[]       @default([]) // Array of tags for search
  topic          String?        // Topik/bab
  usage_count    Int            @default(0) // Berapa kali digunakan di ujian
  last_used_at   DateTime?      // Terakhir digunakan kapan
  is_active      Boolean        @default(true)
  deleted_at     DateTime?
  created_at     DateTime       @default(now())
  updated_at     DateTime       @updatedAt

  teacher        Staff          @relation(fields: [teacher_id], references: [id])
  subject        Subject        @relation(fields: [subject_id], references: [id])
  examQuestions  ExamPackageQuestion[]
  answerRecords  ExamAnswerRecord[]

  @@map("question_banks")
}

// Paket ujian yang dibuat guru dari bank soal
enum ExamType {
  KUIS
  UTS
  UAS
  ULANGAN_HARIAN
  LATIHAN
}

model ExamPackage {
  id             BigInt      @id @default(autoincrement())
  teacher_id     String
  subject_id     BigInt
  title          String
  description    String?     @db.Text
  exam_type      ExamType    @default(KUIS)
  duration       Int         @default(60) // menit
  passing_grade  Int         @default(70) // 0-100
  randomize      Boolean     @default(false)
  is_published   Boolean     @default(false)
  deleted_at     DateTime?
  created_at     DateTime    @default(now())
  updated_at     DateTime    @updatedAt

  teacher        Staff       @relation(fields: [teacher_id], references: [id])
  subject        Subject     @relation(fields: [subject_id], references: [id])
  questions      ExamPackageQuestion[]
  schedules      ExamSchedule[]

  @@map("exam_packages")
}

model ExamPackageQuestion {
  id             BigInt      @id @default(autoincrement())
  package_id     BigInt
  question_id    BigInt
  order          Int         @default(0)
  created_at     DateTime    @default(now())

  package        ExamPackage  @relation(fields: [package_id], references: [id], onDelete: Cascade)
  question       QuestionBank @relation(fields: [question_id], references: [id], onDelete: Cascade)

  @@unique([package_id, question_id])
  @@map("exam_package_questions")
}

// Status siklus hidup jadwal ujian
enum ExamScheduleStatus {
  DRAFT      // Belum dibuka untuk siswa
  OPEN       // Sedang berlangsung, siswa bisa mengerjakan
  PAUSED     // Dijeda sementara
  CLOSED     // Selesai / ditutup manual
}

model ExamSchedule {
  id               BigInt             @id @default(autoincrement())
  package_id       BigInt
  rombel_id        BigInt
  teacher_id       String
  title            String             // Bisa berbeda dari nama paket
  token            String             @unique // Kode akses 6 karakter
  start_at         DateTime           // Kapan ujian dibuka
  end_at           DateTime           // Kapan ujian ditutup
  window_minutes   Int                @default(0) // Toleransi keterlambatan masuk (0 = harus tepat waktu)
  status           ExamScheduleStatus @default(DRAFT)
  deleted_at       DateTime?
  created_at       DateTime           @default(now())
  updated_at       DateTime           @updatedAt

  package          ExamPackage        @relation(fields: [package_id], references: [id])
  rombel           Rombel             @relation(fields: [rombel_id], references: [id])
  teacher          Staff              @relation(fields: [teacher_id], references: [id])
  attempts         ExamAttempt[]

  @@index([teacher_id, status])
  @@index([token])
  @@map("exam_schedules")
}

// Status pengerjaan ujian oleh siswa
enum AttemptStatus {
  IN_PROGRESS  // Sedang mengerjakan
  SUBMITTED    // Sudah submit (auto-graded selesai)
  GRADED       // Sudah dikoreksi guru (essay)
}

model ExamAttempt {
  id           BigInt        @id @default(autoincrement())
  schedule_id  BigInt
  student_id   String
  status       AttemptStatus @default(IN_PROGRESS)
  score        Decimal?      // Final score 0-100 (null jika belum dinilai/ada essay pending)
  auto_score   Decimal?      // Skor dari soal otomatis (MC, TF, SA)
  essay_score  Decimal?      // Skor dari soal essay (manual)
  started_at   DateTime      @default(now())
  submitted_at DateTime?
  graded_at    DateTime?
  graded_by    String?       // Staff ID yang mengoreksi
  deleted_at   DateTime?
  created_at   DateTime      @default(now())
  updated_at   DateTime      @updatedAt

  schedule     ExamSchedule  @relation(fields: [schedule_id], references: [id])
  student      PesertaDidik  @relation(fields: [student_id], references: [id])
  answers      ExamAnswerRecord[]

  @@unique([schedule_id, student_id])
  @@index([schedule_id, status])
  @@map("exam_attempts")
}

model ExamAnswerRecord {
  id           BigInt      @id @default(autoincrement())
  attempt_id   BigInt
  question_id  BigInt
  answer       String      @db.Text  // Jawaban siswa (teks atau index pilihan)
  is_correct   Boolean?              // null jika essay
  score        Decimal?              // Nilai per soal (null jika belum dikoreksi)
  essay_note   String?    @db.Text  // Catatan guru untuk essay
  created_at   DateTime   @default(now())
  updated_at   DateTime   @updatedAt

  attempt      ExamAttempt  @relation(fields: [attempt_id], references: [id], onDelete: Cascade)
  question     QuestionBank @relation(fields: [question_id], references: [id])

  @@unique([attempt_id, question_id])
  @@map("exam_answer_records")
}

model Exam {
  id         BigInt   @id @default(autoincrement())
  subject_id BigInt
  title      String
  description String? @db.Text
  duration   Int      // Duration in minutes
  total_questions Int @default(0)
  passing_score Decimal?
  is_active Boolean  @default(true)
  deleted_at DateTime?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  subject     Subject      @relation(fields: [subject_id], references: [id])
  examResults ExamResult[]

  @@map("exams")
}

model ExamResult {
  id         BigInt   @id @default(autoincrement())
  exam_id    BigInt
  student_id String
  score      Decimal
  answers    Json?    // Student answers
  started_at DateTime?
  finished_at DateTime?
  deleted_at DateTime?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  exam        Exam          @relation(fields: [exam_id], references: [id])
  student     PesertaDidik  @relation(fields: [student_id], references: [id])

  @@unique([exam_id, student_id])
  @@map("exam_results")
}

// Transfer System for Student Class Advancement
model TransferBatch {
  id          String   @id @default(cuid())
  name        String   // "Transfer 2024/2025 → 2025/2026"
  fromYearId  String
  toYearId    String
  status      TransferStatus @default(PENDING)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  fromYear    TahunAjaran @relation("TransferFromYear", fields: [fromYearId], references: [id])
  toYear      TahunAjaran @relation("TransferToYear", fields: [toYearId], references: [id])
  transfers   Transfer[]

  @@map("transfer_batches")
}

model Transfer {
  id            String   @id @default(cuid())
  batchId       String
  studentId     String
  fromClassId   BigInt?  // nullable jika siswa baru
  toClassId     BigInt
  fromGroupId   BigInt?  // nullable jika belum assign rombel
  toGroupId     BigInt?
  status        TransferStatus @default(PENDING)
  notes         String?
  executedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  batch         TransferBatch @relation(fields: [batchId], references: [id])
  student       PesertaDidik  @relation(fields: [studentId], references: [id])
  fromClass     Class?        @relation("TransferFromClass", fields: [fromClassId], references: [id])
  toClass       Class         @relation("TransferToClass", fields: [toClassId], references: [id])
  fromGroup     Rombel?       @relation("TransferFromGroup", fields: [fromGroupId], references: [id])
  toGroup       Rombel?       @relation("TransferToGroup", fields: [toGroupId], references: [id])

  @@map("transfers")
}

enum TransferStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
  FAILED
}

// Attendance / Absensi
enum AttendanceStatus {
  HADIR      // Present
  SAKIT      // Sick
  IZIN       // Permitted absence
  ALPHA      // Absent without permission
}

model Attendance {
  id                 BigInt           @id @default(autoincrement())
  student_id         String
  teacher_subject_id BigInt
  rombel_id          BigInt
  date               DateTime         @db.Date
  meeting_number     Int              // Pertemuan ke-berapa
  status             AttendanceStatus
  notes              String?          @db.Text // Keterangan/alasan
  recorded_by        String?          // Staff ID yang mencatat
  deleted_at         DateTime?
  created_at         DateTime         @default(now())
  updated_at         DateTime         @updatedAt

  student            PesertaDidik     @relation(fields: [student_id], references: [id])
  teacherSubject     TeacherSubject   @relation(fields: [teacher_subject_id], references: [id])
  rombel             Rombel           @relation(fields: [rombel_id], references: [id])
  recorder           Staff?           @relation(fields: [recorded_by], references: [id])

  @@unique([student_id, teacher_subject_id, date, meeting_number])
  @@index([date])
  @@index([rombel_id, date])
  @@index([teacher_subject_id, date])
  @@map("attendances")
}

// Teaching Journal
model TeachingJournal {
  id                 BigInt         @id @default(autoincrement())
  teacher_subject_id BigInt
  rombel_id          BigInt
  date               DateTime       @db.Date
  time_start         String?        // Format: HH:mm
  time_end           String?        // Format: HH:mm
  period             Int?           // Jam pelajaran ke-berapa
  topic              String         @db.Text // Materi yang diajarkan
  teaching_method    String?        @db.Text // Metode pembelajaran
  media_used         String?        @db.Text // Media yang digunakan
  obstacles          String?        @db.Text // Kendala/hambatan
  follow_up          String?        @db.Text // Tindak lanjut
  notes              String?        @db.Text // Catatan tambahan
  recorded_by        String         // Staff ID yang mencatat
  deleted_at         DateTime?
  created_at         DateTime       @default(now())
  updated_at         DateTime       @updatedAt

  teacherSubject TeacherSubject @relation(fields: [teacher_subject_id], references: [id])
  rombel         Rombel         @relation(fields: [rombel_id], references: [id])
  recorder       Staff          @relation("JournalRecorder", fields: [recorded_by], references: [id])

  @@index([date])
  @@index([rombel_id, date])
  @@index([teacher_subject_id, date])
  @@map("teaching_journals")
}

// Teaching Materials
model TeachingMaterial {
  id              BigInt    @id @default(autoincrement())
  teacher_id      String    // Staff ID yang upload
  subject_id      BigInt
  class_id        BigInt?   // Optional - bisa untuk semua kelas
  title           String
  description     String?   @db.Text
  file_url        String?   // URL file yang diupload
  file_type       String?   // pdf, doc, ppt, video, audio, link
  file_name       String?   // Original filename
  file_size       BigInt?   // File size in bytes
  external_link   String?   // For YouTube embed or external links
  chapter         String?   // Chapter/topic name
  tags            String?   // Comma-separated tags
  published_at    DateTime? // Scheduled publishing
  is_shared       Boolean   @default(false) // Dapat dibagikan ke sesama guru
  views           Int       @default(0)
  downloads       Int       @default(0)
  deleted_at      DateTime?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  teacher Staff   @relation("MaterialUploader", fields: [teacher_id], references: [id])
  subject Subject @relation(fields: [subject_id], references: [id])
  class   Class?  @relation(fields: [class_id], references: [id])

  @@index([teacher_id])
  @@index([subject_id])
  @@index([class_id])
  @@index([published_at])
  @@map("teaching_materials")
}

// Syllabus - Silabus Pembelajaran
model Syllabus {
  id                    BigInt    @id @default(autoincrement())
  teacher_id            String    // Staff ID pembuat silabus
  subject_id            BigInt
  class_id              BigInt    // Tingkat kelas
  academic_year         String    // Tahun ajaran (e.g., "2025/2026")
  semester              Int       // 1 atau 2
  title                 String    // Judul silabus
  core_competencies     String?   @db.Text // Kompetensi Inti (KI)
  basic_competencies    String?   @db.Text // Kompetensi Dasar (KD)
  indicators            String?   @db.Text // Indikator pencapaian kompetensi
  subject_matter        String?   @db.Text // Materi Pokok
  learning_activities   String?   @db.Text // Kegiatan Pembelajaran
  assessment            String?   @db.Text // Penilaian
  time_allocation       String?   // Alokasi waktu (e.g., "8 x 45 menit")
  learning_resources    String?   @db.Text // Sumber Belajar
  notes                 String?   @db.Text // Catatan tambahan
  file_url              String?   // Attachment silabus dalam bentuk file
  file_name             String?
  is_approved           Boolean   @default(false) // Approval status
  approved_by           String?   // Staff ID yang approve
  approved_at           DateTime?
  deleted_at            DateTime?
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt

  teacher    Staff     @relation("SyllabusCreator", fields: [teacher_id], references: [id])
  subject    Subject   @relation(fields: [subject_id], references: [id])
  class      Class     @relation(fields: [class_id], references: [id])
  approver   Staff?    @relation("SyllabusApprover", fields: [approved_by], references: [id])
  lessonPlans LessonPlan[]

  @@index([teacher_id])
  @@index([subject_id])
  @@index([class_id])
  @@index([academic_year, semester])
  @@map("syllabuses")
}

// Lesson Plan - Rencana Pelaksanaan Pembelajaran (RPP)
model LessonPlan {
  id                      BigInt    @id @default(autoincrement())
  syllabus_id             BigInt?   // Optional link to syllabus
  teacher_id              String    // Staff ID pembuat RPP
  subject_id              BigInt
  class_id                BigInt
  academic_year           String    // Tahun ajaran (e.g., "2025/2026")
  semester                Int       // 1 atau 2
  title                   String    // Judul/topik pembelajaran
  meeting_number          Int?      // Pertemuan ke-
  time_allocation         String?   // Alokasi waktu (e.g., "2 x 45 menit")
  learning_objectives     String    @db.Text // Tujuan pembelajaran
  indicators              String?   @db.Text // Indikator pencapaian
  subject_matter          String?   @db.Text // Materi pembelajaran
  teaching_method         String?   @db.Text // Metode mengajar
  media_and_tools         String?   @db.Text // Media dan alat pembelajaran
  learning_resources      String?   @db.Text // Sumber belajar
  
  // Langkah-langkah pembelajaran
  opening_activities      String?   @db.Text // Kegiatan pendahuluan
  core_activities         String?   @db.Text // Kegiatan inti
  closing_activities      String?   @db.Text // Kegiatan penutup
  
  // Penilaian
  assessment_technique    String?   @db.Text // Teknik penilaian
  assessment_instrument   String?   @db.Text // Instrumen penilaian
  
  notes                   String?   @db.Text // Catatan
  file_url                String?   // Attachment RPP
  file_name               String?
  
  is_approved             Boolean   @default(false)
  approved_by             String?
  approved_at             DateTime?
  
  deleted_at              DateTime?
  created_at              DateTime  @default(now())
  updated_at              DateTime  @updatedAt

  syllabus   Syllabus? @relation(fields: [syllabus_id], references: [id])
  teacher    Staff     @relation("LessonPlanCreator", fields: [teacher_id], references: [id])
  subject    Subject   @relation(fields: [subject_id], references: [id])
  class      Class     @relation(fields: [class_id], references: [id])
  approver   Staff?    @relation("LessonPlanApprover", fields: [approved_by], references: [id])

  @@index([teacher_id])
  @@index([subject_id])
  @@index([class_id])
  @@index([syllabus_id])
  @@index([academic_year, semester])
  @@map("lesson_plans")
}

// ─── Komunikasi ──────────────────────────────────────────────────────────────

model Discussion {
  id          BigInt    @id @default(autoincrement())
  teacher_id  String
  rombel_id   BigInt?
  subject_id  BigInt?
  title       String
  content     String    @db.Text
  is_pinned   Boolean   @default(false)
  is_closed   Boolean   @default(false)
  deleted_at  DateTime?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  teacher     Staff             @relation(fields: [teacher_id], references: [id])
  rombel      Rombel?           @relation(fields: [rombel_id], references: [id])
  subject     Subject?          @relation(fields: [subject_id], references: [id])
  replies     DiscussionReply[]

  @@index([teacher_id])
  @@index([rombel_id])
  @@map("discussions")
}

enum ReplyAuthorType {
  TEACHER
  STUDENT
}

model DiscussionReply {
  id            BigInt          @id @default(autoincrement())
  discussion_id BigInt
  author_id     String          // Staff ID or Student ID
  author_type   ReplyAuthorType @default(TEACHER)
  content       String          @db.Text
  deleted_at    DateTime?
  created_at    DateTime        @default(now())
  updated_at    DateTime        @updatedAt

  discussion    Discussion      @relation(fields: [discussion_id], references: [id], onDelete: Cascade)

  @@index([discussion_id])
  @@map("discussion_replies")
}

enum MessageSenderType {
  TEACHER
  STUDENT
  PARENT
  ADMIN
}

model Message {
  id            BigInt            @id @default(autoincrement())
  sender_id     String            // Staff/Student/Parent ID
  sender_type   MessageSenderType @default(TEACHER)
  receiver_id   String            // Staff/Student/Parent ID
  receiver_type MessageSenderType @default(TEACHER)
  subject       String?
  content       String            @db.Text
  is_read       Boolean           @default(false)
  read_at       DateTime?
  deleted_at    DateTime?
  created_at    DateTime          @default(now())
  updated_at    DateTime          @updatedAt

  @@index([sender_id, receiver_id])
  @@index([receiver_id, is_read])
  @@map("messages")
}

// API Key manajemen untuk integrasi eksternal
model ApiKey {
  id          String    @id @default(cuid())
  name        String    // Nama/label API key (e.g. "Integrasi DAPODIK")
  key_prefix  String    // 8 karakter pertama, ditampilkan di UI
  key_hash    String    @unique // SHA-256 hash dari full key
  is_active   Boolean   @default(true)
  last_used_at DateTime?
  expires_at  DateTime? // null = tidak pernah kedaluwarsa
  created_by  String?   // staffId atau "system"
  deleted_at  DateTime?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  @@map("api_keys")
}

// Konfigurasi webhook untuk event tertentu
model WebhookConfig {
  id          String    @id @default(cuid())
  event       String    // e.g. "STUDENT_ADMITTED", "GRADE_SUBMITTED", "ATTENDANCE_SAVED"
  label       String    // Label tampilan event
  url         String?   @db.Text // URL endpoint tujuan
  is_active   Boolean   @default(false)
  secret      String?   // Secret untuk HMAC signature (opsional)
  last_triggered_at DateTime?
  last_status Int?      // HTTP status terakhir dari endpoint
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  @@unique([event])
  @@map("webhook_configs")
}

// RBAC: Role-based permission overrides per role (used by CASL ability builder)
model RolePermission {
  id        String   @id @default(cuid())
  role      UserRole
  subject   String   // CASL subject slug, e.g. "akademik.nilai", "pengaturan.system"
  action    String   // "manage" | "read" | "create" | "update" | "delete"
  inverted  Boolean  @default(false) // true = cannot (deny rule)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([role, subject, action])
  @@map("role_permissions")
}

